{
  "model_profile": "balanced",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "tavily_search": false,
  "ref_search": false,
  "perplexity": false,
  "jina": false,
  "git": {
    "branching_strategy": "none",
    "create_tag": true,
    "repo_tagging": "single",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null,
    "allow_default_branch_commits": true
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": true,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "api_coverage_gate": true,
    "human_verify_mode": "end-of-phase",
    "context_guard_mode": "warn",
    "text_mode": false,
    "compact_content": true,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "_auto_chain_active": false,
    "ui_review": true,
    "tdd_mode": false,
    "use_worktrees": true,
    "deep_verify": true
  },
  "ship": {
    "pr_body_sections": [
      {
        "heading": "User Stories & Acceptance Criteria",
        "enabled": true,
        "source": "REQUIREMENTS.md ## User Stories || REQUIREMENTS.md ## Acceptance Criteria",
        "fallback": "- Acceptance criteria are covered by the linked requirements and verification evidence."
      },
      {
        "heading": "Risks & Dependencies",
        "enabled": false,
        "source": "PLAN.md ## Risks || PLAN.md ## Dependencies",
        "fallback": "- No known high-risk rollout dependencies."
      },
      {
        "heading": "Success Metrics & Release Criteria",
        "enabled": false,
        "source": "REQUIREMENTS.md ## Definition of Done || VERIFICATION.md ## Release Criteria",
        "fallback": "- Release when automated verification and required manual checks pass."
      },
      {
        "heading": "Stakeholder Review & Approval",
        "enabled": false,
        "template": "- Product owner approval pending for {phase_name}."
      }
    ]
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {
    "gsd-phase-researcher": [
      "global:codebase-memory",
      "global:context7-mcp",
      "global:threejs-performance"
    ],
    "gsd-planner": [
      "global:codebase-memory",
      "global:context7-mcp",
      "global:vitest",
      ".claude/skills/javascript-testing-expert",
      ".claude/skills/playwright-best-practices",
      ".claude/skills/principle-test-behavior-not-implementation"
    ],
    "gsd-plan-checker": [
      "global:codebase-memory",
      "global:vitest",
      ".claude/skills/playwright-best-practices",
      ".claude/skills/principle-test-behavior-not-implementation",
      ".claude/skills/typescript-best-practices",
      ".claude/skills/principle-type-system-discipline",
      ".claude/skills/principle-boundary-discipline"
    ],
    "gsd-executor": [
      "global:codebase-memory",
      "global:context7-mcp",
      "global:vitest",
      ".claude/skills/javascript-testing-expert",
      ".claude/skills/playwright-best-practices",
      ".claude/skills/typescript-best-practices",
      ".claude/skills/principle-boundary-discipline",
      ".claude/skills/principle-type-system-discipline",
      ".claude/skills/principle-test-behavior-not-implementation",
      ".claude/skills/render-skills-pointer"
    ],
    "gsd-verifier": [
      "global:codebase-memory",
      ".claude/skills/javascript-testing-expert",
      ".claude/skills/principle-test-behavior-not-implementation",
      ".claude/skills/playwright-best-practices",
      ".claude/skills/render-skills-pointer"
    ],
    "gsd-nyquist-auditor": [
      "global:codebase-memory",
      "global:vitest",
      ".claude/skills/javascript-testing-expert",
      ".claude/skills/principle-test-behavior-not-implementation"
    ],
    "gsd-code-reviewer": [
      "global:codebase-memory",
      ".claude/skills/typescript-best-practices",
      ".claude/skills/principle-type-system-discipline",
      ".claude/skills/principle-boundary-discipline",
      ".claude/skills/javascript-testing-expert",
      ".claude/skills/principle-test-behavior-not-implementation",
      ".claude/skills/render-skills-pointer"
    ],
    "gsd-debugger": [
      "global:codebase-memory",
      "global:context7-mcp"
    ],
    "gsd-pattern-mapper": [
      "global:codebase-memory"
    ]
  },
  "claude_md_path": "./.claude/CLAUDE.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "resolve_model_ids": false,
  "mode": "interactive",
  "granularity": "standard",
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true,
    "auto_update": true
  }
}
