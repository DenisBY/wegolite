1	// SPDX-License-Identifier: GPL-2.0-or-later
     2	// Copyright (c) 2026 Wegolite contributors
     3	
     4	/**
     5	 * `npcContacts`: the scanner's view of the world's NPC ships (Phase 12,
     6	 * WORLD-15, scanner half).
     7	 *
     8	 * This is the only world-to-presentation channel for NPC ships. A contact is a
     9	 * plain snapshot with no entity identifier: the HUD, the probe and any later
    10	 * presentation holder receive positions and a colour class, never a handle
    11	 * into the world, so nothing outside the world can outlive it (per-world id
    12	 * scope, CONTEXT D-06 as amended 2026-11-12). Every vector and quaternion is
    13	 * copied, so mutating a contact never changes an entity.
    14	 *
    15	 * Like `view-impl.ts` it reads the live store without changing it and walks it
    16	 * in ascending id order, so the order of the contacts is the order of spawning.
    17	 * It allocates one small array per rendered frame, outside the fixed step.
    18	 *
    19	 * The kind is the scanner colour class only: Oolite draws a police ship in
    20	 * `police_color1` and every other non-hostile ship in `neutral_color`
    21	 * (`ShipEntity.m` lines 5582-5586). Hostility, cargo and the other classes
    22	 * come with the phases that give them meaning.
    23	 */
    24	
    25	import type { Quat, Vec3 } from "../math.js";
    26	import type { World } from "./world.js";
    27	
    28	/** The scanner colour class of a ship contact. */
    29	export type NpcContactKind = "neutral" | "police";
    30	
    31	/** One NPC ship as the scanner sees it. Plain data, no entity id. */
    32	export interface NpcContact {
    33	  readonly position: Vec3;
    34	  readonly orientation: Quat;
    35	  readonly radius: number;
    36	  readonly specKey: string;
    37	  readonly kind: NpcContactKind;
    38	}
    39	
    40	/**
    41	 * The live ships of `world` as id-free contacts, in ascending id order; empty
    42	 * for no world. Dead entities (awaiting the tick-end commit) are skipped.
    43	 */
    44	export function npcContacts(world: World | undefined): readonly NpcContact[] {
    45	  if (world === undefined) return [];
    46	  const contacts: NpcContact[] = [];
    47	  for (const entity of world.store.live) {
    48	    if (entity.dead || entity.kind !== "ship") continue;
    49	    contacts.push({
    50	      position: {
    51	        x: entity.position.x,
    52	        y: entity.position.y,
    53	        z: entity.position.z,
    54	      },
    55	      orientation: {
    56	        w: entity.orientation.w,
    57	        x: entity.orientation.x,
    58	        y: entity.orientation.y,
    59	        z: entity.orientation.z,
    60	      },
    61	      radius: entity.radius,
    62	      specKey: entity.specKey,
    63	      kind: entity.scanClass === "CLASS_POLICE" ? "police" : "neutral",
    64	    });
    65	  }
    66	  return contacts;
    67	}
    68	
    69	/**
    70	 * One piece of debris (a cargo pod, a metal plate or a wreck) as the render
    71	 * sees it (WORLD-17). Plain data, no entity id, every vector and quaternion
    72	 * copied, like `NpcContact`.
    73	 *
    74	 * Debris is presentation-only here: it is drawn, never shown on the scanner.
    75	 * Oolite draws `CLASS_CARGO` on the scanner; that gap is recorded (D16-26) and
    76	 * deferred with scooping (CBT-11), so `npcContacts` stays ships only.
    77	 */
    78	export interface DebrisContact {
    79	  readonly position: Vec3;
    80	  readonly orientation: Quat;
    81	  readonly radius: number;
    82	  readonly specKey: string;
    83	}
    84	
    85	/**
    86	 * The live cargo and wreckage of `world` as id-free contacts, in ascending id
    87	 * order; empty for no world. Dead entities (awaiting the tick-end commit) are
    88	 * skipped. Ships and every other kind are left to `npcContacts`.
    89	 */
    90	export function debrisContacts(
    91	  world: World | undefined,
    92	): readonly DebrisContact[] {
    93	  if (world === undefined) return [];
    94	  const contacts: DebrisContact[] = [];
    95	  for (const entity of world.store.live) {
    96	    if (entity.dead) continue;
    97	    if (entity.kind !== "cargo" && entity.kind !== "wreckage") continue;
    98	    contacts.push({
    99	      position: {
   100	        x: entity.position.x,
   101	        y: entity.position.y,
   102	        z: entity.position.z,
   103	      },
   104	      orientation: {
   105	        w: entity.orientation.w,
   106	        x: entity.orientation.x,
   107	        y: entity.orientation.y,
   108	        z: entity.orientation.z,
   109	      },
   110	      radius: entity.radius,
   111	      specKey: entity.specKey,
   112	    });
   113	  }
   114	  return contacts;
   115	}
