    61	  readonly start: number;
    62	  readonly end: number;
    63	  readonly block: readonly string[];
    64	}
    65	
    66	function read(relativePath: string): string {
    67	  return readFileSync(join(REPO_ROOT, relativePath), "utf8");
    68	}
    69	
    70	/** The cell values of a markdown table row, trimmed. */
    71	function cellsOf(line: string): string[] {
    72	  return line
    73	    .split("|")
    74	    .slice(1, -1)
    75	    .map((cell) => cell.trim());
    76	}
    77	
    78	/** A cell with its Markdown code-span backticks removed. */
    79	function bare(cell: string): string {
