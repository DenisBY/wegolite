   141	
   142	  /**
   143	   * What the drawn image depends on besides the simulation: the flight state
   144	   * object (replaced by a Load), the scene (replaced by a jump, a quality
   145	   * change or a test swap) and the nebula textures, which arrive after the
   146	   * scene is built.
   147	   */
   148	  function drawKeys(): readonly unknown[] {
   149	    // Read at this call, never kept: the keys compare the live objects by identity.
   150	    const { state, scene } = ctx.core;
   151	    return [state, scene, scene?.nebulae?.revision() ?? 0];
   152	  }
   153	
   154	  /**
   155	   * Whether the loop's next frame has to reach the GPU (see `redraw-gate.ts`).
   156	   * A docked or paused session simulates nothing, so its image cannot change;
   157	   * a docked session in the launch pre-roll moves its camera every step and is
   158	   * drawn (quick 261118-os8).
   159	   */
   160	  function shouldDraw(): boolean {
   161	    const { paused } = ctx.runtime;
   162	    const { state } = ctx.core;
   163	    const frozenDocked = state?.mode === "docked" && !launchSequence.preRolling;
   164	    return redrawGate.next(paused || frozenDocked, drawKeys());
   165	  }
   166	
   167	  /**
