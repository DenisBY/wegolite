   127	export function createRenderDriver(ctx: SessionState, deps: RenderDriverDeps) {
   128	  const {
   129	    renderer,
   130	    hudCanvas,
   131	    probe,
   132	    redrawGate,
   133	    messages,
   134	    galaxyById,
   135	    updateProbe,
   136	    renderStation,
   137	    targetSystem,
   138	    npcModels,
   139	    launchSequence,
