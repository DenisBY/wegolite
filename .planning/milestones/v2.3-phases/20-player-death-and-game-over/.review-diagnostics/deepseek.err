244	@implementation OOSmallFragmentBurstEntity : OOParticleSystem
   245	
   246	- (id)initFragmentBurstFrom:(HPVector)fragPosition velocity:(Vector)fragVelocity size:(GLfloat)size
   247	{
   248	    enum {
   249	        kMinSpeed = 100,
   250	        kMaxSpeed = 400
   251	    };
   252	
   253	    unsigned count = 0.4f * size;
   254	    count = MIN(count | 12, (unsigned)kFragmentBurstMaxParticles);
   255	
   256	    // Select base colour
   257	    // yellow/orange (0.12) through yellow (0.1667) to yellow/slightly green (0.20)
   258	    OOColor* hsvColor = [OOColor colorWithHue:0.12f + 0.08f * randf() saturation:1.0f brightness:1.0f alpha:1.0f];
   259	    GLfloat baseColor[4];
   260	    [hsvColor getRed:&baseColor[0] green:&baseColor[1] blue:&baseColor[2] alpha:&baseColor[3]];
   261	
   262	    if ((self = [super initWithPosition:fragPosition velocity:fragVelocity count:count minSpeed:kMinSpeed maxSpeed:kMaxSpeed duration:1.5 baseColor:baseColor])) {
   263	        for (unsigned i = 0; i < count; i++) {
   264	            // Note: initWithPosition:... stashes speeds in _particleSize[].
   265	            _particleSize[i] = 32.0f * kMinSpeed / _particleSize[i];
   266	        }
   267	    }
   268	
   269	    return self;
   270	}
