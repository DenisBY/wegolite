  3566	- (void)gameOverFadeToBW
  3567	{
  3568	    float secondsToBWFadeOut = [[NSUserDefaults standardUserDefaults] oo_floatForKey:@"gameover-seconds-to-bw-fadeout" defaultValue:5.0f];
  3569	    if ([UNIVERSE detailLevel] >= DETAIL_LEVEL_SHADERS && secondsToBWFadeOut > 0.0f) {
  3570	        MyOpenGLView* gameView = [UNIVERSE gameView];
  3571	        static float originalColorSaturation = -1.0f;
  3572	        if (originalColorSaturation == -1.0f)
  3573	            originalColorSaturation = [gameView colorSaturation];
  3574	        if ([self shotTime] < secondsToBWFadeOut) {
  3575	            // fade to black & white within secondsToBWFadeOut, independently of
  3576	            // frame rate and original color saturation
  3577	            if (fps_counter != 0) {
  3578	                [gameView adjustColorSaturation:-(originalColorSaturation * (1.0f / secondsToBWFadeOut) * [UNIVERSE timeAccelerationFactor] / fps_counter)];
  3579	            }
  3580	        }
  3581	
  3582	        if ([self shotTime] > kDeadResetTime) {
  3583	            // make sure to subtract the current saturation because if the user presses space to skip
  3584	            // the game over screen before the transition to b/w has been completed, whatever is left
  3585	            // will be added to the original saturation, resulting in an oversaturated image
  3586	            [gameView adjustColorSaturation:originalColorSaturation - [gameView colorSaturation]];
  3587	            originalColorSaturation = -1.0f;
  3588	        }
  3589	    }
  3590	}
