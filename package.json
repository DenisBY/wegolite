{
  "name": "wegolite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "assets:build": "tsx tools/oolite-ingest/cli.ts",
    "assets:check": "tsx tools/oolite-ingest/cli.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:cross": "xvfb-run -a playwright test --project=firefox --workers=1"
  },
  "dependencies": {
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
